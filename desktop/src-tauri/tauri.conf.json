{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T-Bridge",
  "version": "0.2.0",
  "identifier": "app.kopru.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "tdesk.studio",
    "shortDescription": "Telefon ↔ PC köprüsü",
    "longDescription": "Aynı Wi-Fi üzerinden pano, dosya, bildirim ve uzaktan kumanda",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "t-bridge",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCMTE2OTdGNUY4REYxQjUKUldTMThZMWZmMmtSUzVFVlFwdEpIVjNzbFN3NWJhc3dsbkhOQ2xzVGQrNE1VMFVUZHV1L0h2bEsK",
      "endpoints": [
        "https://github.com/taha-sa/t-bridge-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}