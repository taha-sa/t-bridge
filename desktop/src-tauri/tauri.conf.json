{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Köprü",
  "version": "0.1.0",
  "identifier": "app.kopru.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Köprü",
    "shortDescription": "Telefon ↔ PC paylaşım",
    "longDescription": "Aynı Wi-Fi üzerinden pano, dosya, bildirim ve uzaktan kumanda",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Turkish"
        ],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}