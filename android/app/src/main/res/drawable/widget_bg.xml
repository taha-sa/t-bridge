<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- İnce altın kenar -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="315" android:startColor="#99F7CF5A" android:centerColor="#22D99A0B" android:endColor="#669C6400" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient android:angle="270" android:startColor="#FF1A1916" android:endColor="#FF0C0C0D" />
        </shape>
    </item>
</layer-list>
